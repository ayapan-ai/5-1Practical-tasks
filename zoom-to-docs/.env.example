# Zoom App Marketplace で作成した Server-to-Server OAuth アプリの認証情報
# (4-3AIP連携課題/.env と同じ値。スコープ cloud_recording:read:list_user_recordings:admin
#  と cloud_recording:read:recording:admin が必要)
ZOOM_ACCOUNT_ID=xxxxxxxxxxxx
ZOOM_CLIENT_ID=xxxxxxxxxxxx
ZOOM_CLIENT_SECRET=xxxxxxxxxxxx

# OpenAI のAPIキー(4-3AIP連携課題/.env と同じ値でよい)
OPENAI_API_KEY=sk-xxxxxxxxxxxx
# 任意: 議事録作成に使うモデル(デフォルト gpt-5.4-mini)
OPENAI_MODEL=

# GoogleのOAuthクライアント(デスクトップアプリ)のJSONと、ログイン後に保存されるトークン
# (相対パスはこのフォルダ基準)
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# 任意: 議事録の保存先DriveフォルダのID(URLの /folders/ の後ろ)。空ならマイドライブ直下
GOOGLE_DRIVE_FOLDER_ID=

# 任意: 何日前までの録画を対象にするか(デフォルト 7)
LOOKBACK_DAYS=
# 任意: false にすると議事録の末尾に文字起こしの原文を載せない(デフォルト true)
INCLUDE_TRANSCRIPT=

# 任意: 作成完了の報告メールの宛先(Gmailで送信)。空ならメールを送らない
MAIL_TO=

# 任意: 失敗した時・Googleのログインが切れそうな時にLINEで知らせる
# (slack-to-line/.env と同じ値をコピーすれば同じ公式LINEアカウントから届く)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
